# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 32 字节 UTF-8，用于 AES-GCM 加密第三方凭据。可执行 `openssl rand -base64 24` 生成。
CREDENTIAL_ENCRYPTION_KEY="dev-only-32-byte-key-please-edit"

# OpenRouter
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_BASE_URL="https://openrouter.ai"

# OpenCode Go
OPENCODE_GO_WORKSPACE_ID="wrk_xxx"
OPENCODE_GO_AUTH_COOKIE="cookie=value; another=value"
OPENCODE_GO_BASE_URL="https://opencode.ai"

# 讯飞 MaaS
XFYUN_MAAS_PAGE_URL="https://maas.xfyun.cn/packageSubscription"
XFYUN_MAAS_API_URL="https://maas.xfyun.cn/api/v1/gpt-finetune/coding-plan/list?page=1&size=6"
XFYUN_MAAS_AUTH_COOKIE="cookie=value; another=value"

# 阿里云百炼
ALIYUN_BAILIAN_PAGE_URL="https://bailian.console.aliyun.com/cn-beijing?tab=plan#/efm/subscription/coding-plan"
ALIYUN_BAILIAN_API_URL=""
ALIYUN_BAILIAN_AUTH_COOKIE="cookie=value; another=value"
ALIYUN_BAILIAN_SEC_TOKEN=""
ALIYUN_BAILIAN_CLOUD_FETCH=""

# 火山方舟
VOLC_ARK_PAGE_URL="https://console.volcengine.com/ark/region:ark+cn-beijing/openManagement?LLM=%7B%7D&advancedActiveKey=subscribe"
VOLC_ARK_API_URL=""
VOLC_ARK_AUTH_COOKIE="csrfToken=...; digest=...; AccountID=..."


# DeepSeek
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_USER="13800000000"
DEEPSEEK_PASS="your-platform-password"
DEEPSEEK_PAGE_URL="https://platform.deepseek.com/usage"
DEEPSEEK_USER_TOKEN="platform-login-token"
DEEPSEEK_AUTH_COOKIE="HWWAFSESID=...; HWWAFSESTIME=...; smidV2=..."
# Cloudflare deployment
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
FRONTEND_BASE_URL="apimonitor.example.workers.dev"

# 本地脚本推送 opencode 用量快照时使用的共享密钥（Worker 端需配置同名 secret）
INGEST_API_KEY="replace-with-random-32-char-secret"
# 本地脚本推送目标（Worker 线上地址）
APIMONITOR_INGEST_URL="https://apimonitor.bondtoolbox.asia"
