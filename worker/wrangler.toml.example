name = "apimonitor"
main = "./worker/index.ts"
compatibility_date = "2026-06-11"

[vars]
# Put non-secret defaults here. Real secrets should be configured in Cloudflare dashboard or bindings.
OPENROUTER_BASE_URL = "https://openrouter.ai"
OPENCODE_GO_BASE_URL = "https://opencode.ai"
XFYUN_MAAS_PAGE_URL = "https://maas.xfyun.cn/packageSubscription"
VOLC_ARK_PAGE_URL = "https://console.volcengine.com/ark/region:ark+cn-beijing/openManagement?LLM=%7B%7D&advancedActiveKey=subscribe"

[[durable_objects.bindings]]
name = "REFRESH_SESSION"
class_name = "RefreshSessionDurableObject"

[migrations]
tag = "v1"
new_sqlite_classes = ["RefreshSessionDurableObject"]

[assets]
directory = "./frontend/dist"
not_found_handling = "single-page-application"
# 不需要 run_worker_first：wrangler 4 默认行为是 assets 不匹配时自动 fallback 到 worker
