{
  "name": "api-usage-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "tsc --noEmit && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "deploy:worker": "npm run build:frontend && npx wrangler@4 deploy",
    "deploy:frontend": "npm --prefix frontend run build",
    "test": "vitest run tests/frontend tests/worker",
    "test:watch": "vitest",
    "test:frontend": "vitest run tests/frontend",
    "test:worker": "vitest run tests/worker"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.2",
    "@testing-library/react": "^15.0.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "happy-dom": "^14.12.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "wrangler": "^3.72.0",
    "@vitejs/plugin-react": "^4.3.1"
  }
}
